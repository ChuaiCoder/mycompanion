    {
      "path": "src/prompt-manager-core.ts",
      "upstreamPaths": [
        "public/scripts/PromptManager.js",
        "public/scripts/openai.js"
      ],
      "adaptation": "Typed invocation-owned data-only Prompt, PromptCollection, PromptManager preparation/order/name methods; default prompts/formats; preparePromptsForChatCompletion and strict parseExampleIntoIndividual. Separate product fallback normalizes a known speaker's full-width colon only when strict parsing returned no messages; this fallback is not attributed to Tavern. DOM/UI/account state excluded."
    },
    {
      "path": "src/managed-prompt-assembly.ts",
      "upstreamPaths": [
        "public/scripts/openai.js",
        "public/script.js"
      ],
      "adaptation": "Synchronous text-only population with shared macro session and tokenizer; preserves independent preset/extension/history/example substitutions and visited history traversal. WI example entries use original baseChatReplace/parseMesExamples insertion phase. Adds project memory/summary/declarative command regions, pinned-memory retention, 512-token reserve and protects current user input. Non-constant unchanged prepared WI groups may be trimmed without re-evaluating macros; transformed groups cannot be split safely and remain fixed. Tools, media, continuation and groups require separate host adapters."
    },
    {
      "path": "src/power-user-core.ts",
      "upstreamPaths": [
        "public/scripts/personas.js"
      ],
      "adaptation": "Normalize legacy persona description position AFTER_CHAR=1 to IN_PROMPT=0 when reading effective host state, matching original setPersonaDescription migration; stored input is not mutated. Browser persona selection applies the same migration."
    }
  ],
