{
  "name": "@mycompanion/local-service",
  "version": "0.2.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Loopback-only local service embedded in MyCompanion Desktop",
  "type": "module",
  "main": "./dist/app.js",
  "types": "./src/app.ts",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/deepmerge": "3.2.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.4",
    "@mycompanion/character-card": "0.2.1",
    "@mycompanion/shared": "0.2.1",
    "eventsource-parser": "4.1.1",
    "fastify": "5.12.5",
    "gpt-tokenizer": "4.0.0",
    "sanitize-filename": "1.6.3",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "3.3.1",
    "vitest": "5.0.1"
  }
}
